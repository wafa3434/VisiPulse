# ---------------------------------------------------------------------------
# إعدادات قاعدة البيانات
# ---------------------------------------------------------------------------
# للتشغيل المحلي (SQLite):
VISIPULSE_DB_URL=sqlite:///visipulse.db

# للتشغيل في بيئة الإنتاج (مثال لـ PostgreSQL):
# VISIPULSE_DB_URL=postgresql://username:password@localhost:5432/visipulse_db

# ---------------------------------------------------------------------------
# إعدادات الأمان والتشفير (حساس جداً)
# ---------------------------------------------------------------------------
# مفتاح تشفير البيانات (Fernet Key) - يستخدم لتشفير وصف المشاكل والقرارات
# لتوليد مفتاح جديد، استخدم: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VISIPULSE_ENCRYPTION_KEY=N2_80v-4yv-k_R9FhG7mQ8x8uL_f5h2BvR-jS8uH3kE=

# الحد الأقصى لمحاولات تسجيل الدخول الفاشلة قبل قفل الحساب
VISIPULSE_MAX_LOGIN_ATTEMPTS=5

# مدة قفل الحساب بالدقائق في حال تجاوز المحاولات الفاشلة
VISIPULSE_LOCKOUT_MINUTES=15

# مدة انتهاء الجلسة (تسجيل خروج تلقائي) في حال عدم النشاط (بالدقائق)
VISIPULSE_SESSION_TIMEOUT_MIN=30

# ---------------------------------------------------------------------------
# إعدادات النظام والملفات
# ---------------------------------------------------------------------------
# مسار ملف السجلات (Audit & Error Logs)
VISIPULSE_LOG_FILE=visipulse.log

# مسار شعار التجمع الصحي (Logo)
VISIPULSE_LOGO_PATH=logo.jpeg

# إجبار المستخدمين على تغيير كلمة المرور عند أول دخول (true/false)
VISIPULSE_FORCE_PW_CHANGE=true
